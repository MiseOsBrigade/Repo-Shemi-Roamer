{
  "name": "miseos-registry-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @miseos/api dev",
    "test": "pnpm --filter @miseos/core build && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @miseos/core build && pnpm -r typecheck",
    "validate:catalog": "pnpm --filter @miseos/core build && pnpm --filter @miseos/cli start catalog validate",
    "miseos": "pnpm --filter @miseos/cli start",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:catalog && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
