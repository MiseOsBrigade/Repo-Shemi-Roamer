{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miseos.dev/schemas/miseverse-manifest.schema.json",
  "title": "Signed Miseverse Character Grid Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "asset", "hotspots", "policy", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "asset": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "hotspots": { "type": "array", "minItems": 1 },
    "policy": { "type": "object" },
    "signature": {
      "type": "object",
      "required": ["alg", "keyId", "value"],
      "properties": {
        "alg": { "const": "Ed25519" },
        "keyId": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
